# Copy to .env (npm run setup does this for you). .env is ignored by git; never commit real values.

# Local development only: the dev server signs you in as seedy@sites.test, and this makes that
# account the first administrator. Leave it as is for local work.
UFS_OWNER_EMAIL=seedy@sites.test

# Local development only: creates a few sample people, requests and tasks when the first administrator opens the app.
# Leave this out in production; real deployments never create sample data.
UFS_DEMO_DATA=enabled

# Standalone email + password sign-in and password reset need these. Leave them unset locally
# unless you are testing against the approved Supabase project (see docs/password-reset-setup-and-testing.md).
# UFS_AUTH_MODE=pilot
# UFS_SUPABASE_URL=https://ycswaipyuonxwyalkits.supabase.co
# UFS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# UFS_SUPABASE_SESSION_CHECK=enabled
# Password reset stays off unless this is set (see docs/password-reset-setup-and-testing.md first):
# UFS_PASSWORD_RECOVERY=enabled

# Optional alternative sign-in provider (see docs/convex-auth-provider.md). Supabase is used unless this is set.
# UFS_AUTH_PROVIDER=convex
# UFS_AUTH_MODE=standalone
# UFS_CONVEX_URL=https://your-deployment.convex.cloud
# UFS_CONVEX_SITE_URL=https://your-deployment.convex.site
# UFS_CONVEX_OWNER_SUB=<convex user id of the first administrator>
# UFS_CONVEX_OWNER_EMPLOYEE_ID=<existing admin employee id>
